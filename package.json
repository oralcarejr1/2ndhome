{
  "name": "2ndhome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "이사 갈 집 인테리어 3D 플래너 — 실제 가구 치수 배치, 버전 저장, 무드보드, 인체치수 체크",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json",
    "test": "vitest run",
    "dev:server": "APP_PASSWORD=${APP_PASSWORD:-local} vite"
  },
  "dependencies": {
    "@react-three/drei": "9.117.3",
    "@react-three/fiber": "8.17.10",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.11.0",
    "idb-keyval": "6.2.1",
    "immer": "10.1.1",
    "lucide-react": "0.460.0",
    "pretendard": "1.3.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.5",
    "three": "0.170.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
